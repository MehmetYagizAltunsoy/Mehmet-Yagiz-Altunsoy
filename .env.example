# https://isthereanydeal.com/apps/my/ adresinden ücretsiz alınır
ITAD_API_KEY=buraya_anahtarini_yaz
# İsteğe bağlı: Steam'deki tüm oyunlar için (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=
# Anahtar sayfasındaki "per 5 minute window" sayısı (e-postanı doğrulayınca artar)
ITAD_RATE_LIMIT=100
PORT=3000
# Sitede kaç popüler oyun olsun (en fazla 1000). Arama ile bunların dışındakiler de eklenebilir.
CATALOG_SIZE=1000
# Az bakılan oyunların fiyatı kaç saatte bir güncellensin
TAIL_REFRESH_HOURS=24
# Popüler oyunların fiyatları kaç dakikada bir güncellensin
SYNC_MINUTES=60
DB_PATH=ganimet.db

# Sitenin adresi (maillerdeki link için)
SITE_URL=http://localhost:3000

# Mail gönderimi (boş bırakırsan mailler sadece terminale yazdırılır)
# Gmail örneği: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_PASS = Google "uygulama şifresi"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Fiyatavı <bildirim@ornek.com>

# Site adı ve Yardım sayfasındaki iletişim bilgileri ("npm run kurulum" da sorar)
SITE_NAME=Fiyatavı
SUPPORT_EMAIL=
SUPPORT_INSTAGRAM=
# KVKK metinlerindeki veri sorumlusunun adı soyadı / unvanı
CONTROLLER_NAME=

# Sitede hiç gösterilmesin istediğin mağazalar, virgülle (ör. SHOPS_HIDE=Fanatical,Gamesplanet)
# Açılmayan mağazalar zaten otomatik gizlenir; bu satır, kendin gizlemek istediklerin için.
SHOPS_HIDE=

# Yönetim sekmesini görebilecek e-posta adresleri, virgülle (boşsa SUPPORT_EMAIL kullanılır)
ADMIN_EMAILS=
